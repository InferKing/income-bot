INCOME_TG_BOT_TOKEN=replace-with-bot-token
INCOME_TG_TELEGRAM_OWNER_ID=123456789
POSTGRES_PASSWORD=replace-with-a-long-random-password
INCOME_TG_DATABASE_URL=postgresql+asyncpg://income_tg:replace-with-a-long-random-password@postgres:5432/income_tg
INCOME_TG_LOG_LEVEL=INFO
# Временный ручной курс до подключения market-data адаптера. 0 = не показывать конвертацию.
INCOME_TG_MANUAL_USDT_RUB_RATE=0
INCOME_TG_INITIAL_PAPER_BALANCE_RUB=100000
INCOME_TG_ENVIRONMENT=development
INCOME_TG_PAPER_ONLY=true
INCOME_TG_DEBUG=false
INCOME_TG_MARKET_SOURCES=BYBIT,OKX
INCOME_TG_SYMBOLS=BTCUSDT,ETHUSDT,TONUSDT
# Используется только backup-задачей; не выводится в логи.
INCOME_TG_BACKUP_DATABASE_DSN=postgresql://income_tg:replace-with-a-long-random-password@postgres:5432/income_tg
